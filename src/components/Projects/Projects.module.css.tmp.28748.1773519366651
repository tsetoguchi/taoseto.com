.container {
  background-color: var(--color-bg) !important;
  padding-top: 0 !important;
  /* user-select: none; */

}

.carousel {
  height: auto;
  max-height: none;
  overflow: visible;
  position: relative;
}

.carouselItem {
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
}

.imageContainer {
  width: 75%;
  margin: 0 auto;
  position: relative;
  aspect-ratio: 16 / 9;
  max-height: 50vh;
  background-color: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.imageContainer img {
  max-height: 100%;
  max-width: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.carouselContent {
  background-color: var(--color-bg);
  padding: 1rem;
  margin-top: 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  position: relative;
  z-index: 2;
}

.carouselIndicators {
  margin-bottom: 1rem;
}

.carousel .carousel-indicators button {
  margin-top: 100px !important;
}

.carousel :global(.carousel-control-prev),
.carousel :global(.carousel-control-next) {
  height: 50vh;
  top: 10vh;
  bottom: auto;
  align-items: flex-end;
  padding-bottom: 1rem;
}

.carousel :global(.carousel-control-prev-icon),
.carousel :global(.carousel-control-next-icon) {
  width: 3rem;
  height: 3rem;
}

.carouselControls {
  display: flex;
  justify-content: space-between;
  width: 100%;
  max-width: 200px;
  margin-bottom: 1rem;
  position: relative;
}

.carouselCaption {
  position: relative !important;
  left: auto !important;
  transform: none !important;
  bottom: auto !important;
  color: white;
  background-color: transparent;
  padding: 10px;
  border-radius: 5px;
  max-width: 80%;
  margin: 0 auto;
  width: 100%;
  text-align: center;
}

.carouselCaption h3,
.carouselCaption p {
  width: 100%;
  margin: 0 auto;
}

.captionWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--color-text);
}

@media screen and (max-width: 852px) {

  .carousel {
    max-height: 100vh;
    overflow-x: hidden;
  }

  .imageContainer img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .carouselContent {
    padding: 0.5rem;
    margin-top: 0.5rem;
  }

  .carouselIndicators {
    margin-bottom: 0.5rem;
  }

  .carousel .carousel-indicators button {
    margin-top: 40px !important;
    width: 10px;
    height: 10px;
  }

  .carouselControls {
    max-width: 150px;
    margin-bottom: 0.5rem;
  }

  .carouselCaption {
    padding: 8px;
    font-size: 0.9rem;
    max-width: 90%;
  }

  .carouselCaption h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .carouselCaption p {
    font-size: 0.9rem;
  }

  .captionWrapper {
    padding: 0.5rem;
    text-align: center;
  }

  .container {
    padding: 0 !important;
  }
}
