@import "../../vars.css";

.container {
    position: relative;
    background-color: var(--color-bg);
    min-height: 100vh;
    padding: 100px;
    padding-top: 0 !important;
    font-family: var(--font-default);
}

/* ── Page header ── */
.content {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    z-index: 1;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
}

.pageHeader {
    margin-bottom: 56px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.1);
    padding-bottom: 24px;
}

.pageTitle {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.4);
    margin: 0 0 10px;
}

.headerRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.pageSubtitle {
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
}

.resumeBtn {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.4);
    text-decoration: none;
    border: 1px solid rgba(245, 245, 245, 0.15);
    padding: 8px 20px;
    border-radius: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
}

.resumeBtn:hover {
    color: var(--color-text);
    border-color: rgba(245, 245, 245, 0.4);
}

/* ── Timeline ── */
.timeline {
    display: flex;
    flex-direction: column;
}

.entry {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 0 28px;
    padding-bottom: 52px;
}

.entryMarker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6px;
}

.dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: rgba(245, 245, 245, 0.25);
    border: 1px solid rgba(245, 245, 245, 0.4);
    flex-shrink: 0;
}

.line {
    width: 1px;
    flex: 1;
    background-color: rgba(245, 245, 245, 0.08);
    margin-top: 8px;
}

/* ── Entry content ── */
.entryContent {
    padding-bottom: 4px;
}

.entryHeader {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 4px;
}

.companyName {
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: opacity 0.2s ease;
}

.companyName:hover {
    opacity: 0.7;
}

.period {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: rgba(245, 245, 245, 0.3);
}

.role {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.35);
    margin: 0 0 20px;
}

.bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-left: 1px solid rgba(245, 245, 245, 0.07);
    padding-left: 20px;
}

.bullet {
    font-size: 0.88rem;
    color: rgba(245, 245, 245, 0.55);
    line-height: 1.65;
}

/* ── Mobile ── */
@media screen and (max-width: 852px) {
    .container {
        padding: 50px;
        padding-top: 30% !important;
    }

    .pageSubtitle {
        font-size: 1.8rem;
    }

    .headerRow {
        flex-direction: column;
        gap: 16px;
    }

    .resumeBtn {
        align-self: flex-start;
    }

    .entry {
        grid-template-columns: 18px 1fr;
        gap: 0 16px;
        padding-bottom: 40px;
    }

    .companyName {
        font-size: 1.1rem;
    }

    .entryHeader {
        flex-direction: column;
        gap: 4px;
    }

    .period {
        font-size: 0.7rem;
    }
}
