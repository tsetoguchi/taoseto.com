@import "../../vars.css";

.container {
    position: relative;
    background-color: var(--color-bg);
    min-height: 100vh;
    padding: 100px;
    padding-top: 0 !important;
    display: flex;
    flex-direction: column;
    font-family: var(--font-default);
}

/* ── Page header ── */
.pageHeader {
    margin-bottom: 56px;
    border-bottom: 1px solid rgba(245, 245, 245, 0.1);
    padding-bottom: 24px;
}

.pageTitle {
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.4);
    margin: 0 0 10px;
}

.pageSubtitle {
    font-size: 2.4rem;
    font-weight: 300;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
}

/* ── Two-column layout ── */
.layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
}

/* ── Tiers ── */
.tiersSection {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.tiersLabel {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.35);
    margin-bottom: 20px;
}

.tierCard {
    border: 1px solid rgba(245, 245, 245, 0.08);
    border-radius: 4px;
    padding: 28px 32px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    background-color: transparent;
    position: relative;
    overflow: hidden;
}

.tierCard::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: transparent;
    transition: background-color 0.2s ease;
}

.tierCard:hover {
    border-color: rgba(245, 245, 245, 0.2);
    background-color: rgba(245, 245, 245, 0.02);
}

.tierCard:hover::before {
    background-color: rgba(245, 245, 245, 0.2);
}

.tierCard.selected {
    border-color: rgba(245, 245, 245, 0.35);
    background-color: rgba(245, 245, 245, 0.03);
}

.tierCard.selected::before {
    background-color: rgba(245, 245, 245, 0.7);
}

.tierCard.featured {
    border-color: rgba(245, 245, 245, 0.15);
}

.tierCard.featured.selected {
    border-color: rgba(245, 245, 245, 0.4);
    background-color: rgba(245, 245, 245, 0.04);
}

.tierHeader {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
}

.tierName {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.01em;
}

.tierBadge {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.5);
    border: 1px solid rgba(245, 245, 245, 0.2);
    padding: 2px 8px;
    border-radius: 2px;
}

.tierPrice {
    font-size: 0.8rem;
    color: rgba(245, 245, 245, 0.4);
    margin-bottom: 16px;
}

.tierDivider {
    height: 1px;
    background-color: rgba(245, 245, 245, 0.07);
    margin-bottom: 16px;
}

.tierFeatures {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.tierFeature {
    font-size: 0.82rem;
    color: rgba(245, 245, 245, 0.55);
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1.4;
}

.tierFeature::before {
    content: '';
    width: 12px;
    height: 1px;
    background-color: rgba(62, 180, 212, 0.5);
    flex-shrink: 0;
}

.tierCard.selected .tierFeature {
    color: rgba(245, 245, 245, 0.75);
}

/* ── Form section ── */
.formSection {
    display: flex;
    flex-direction: column;
}

.formLabel {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.35);
    margin-bottom: 20px;
}

.form {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.formGroup {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid rgba(245, 245, 245, 0.08);
    padding: 20px 0;
    transition: border-color 0.2s ease;
}

.formGroup:first-child {
    border-top: 1px solid rgba(245, 245, 245, 0.08);
}

.formGroup:focus-within {
    border-bottom-color: rgba(62, 180, 212, 0.5);
}

.label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.35);
    margin-bottom: 8px;
    transition: color 0.2s ease;
}

.formGroup:focus-within .label {
    color: var(--color-primary);
}

.input,
.nameInput,
.select,
.textarea {
    width: 100%;
    padding: 6px 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-family: var(--font-default);
    font-size: 0.95rem;
    font-weight: 300;
}

.input::placeholder,
.nameInput::placeholder,
.textarea::placeholder {
    color: rgba(245, 245, 245, 0.18);
}

.select {
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%233eb4d4' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 4px center;
    background-size: 14px;
    padding-right: 24px;
}

.select option {
    background-color: #1a1a1a;
    color: var(--color-text);
}

.textarea {
    min-height: 100px;
    resize: none;
    line-height: 1.6;
}

.submitBtn {
    margin-top: 36px;
    align-self: flex-start;
    padding: 14px 40px;
    background-color: transparent;
    border: 1px solid rgba(62, 180, 212, 0.5);
    color: var(--color-primary);
    font-family: var(--font-default);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.submitBtn:hover {
    background-color: var(--color-primary);
    color: var(--color-bg);
    border-color: var(--color-primary);
}

.submitBtn:active {
    opacity: 0.8;
}

.submitBtn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

/* ── Messages ── */
.messageContainer {
    min-height: 24px;
    margin-top: 16px;
}

.successMessage {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    padding: 12px 0;
    border-top: 1px solid rgba(62, 180, 212, 0.3);
}

.errorMessage {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: #e07070;
    padding: 12px 0;
    border-top: 1px solid rgba(224, 112, 112, 0.3);
}

/* ── Mobile ── */
@media screen and (max-width: 900px) {
    .container {
        padding: 50px 24px;
        padding-top: 30% !important;
    }

    .pageSubtitle {
        font-size: 1.8rem;
    }

    .layout {
        grid-template-columns: 1fr;
        gap: 48px;
    }

    .submitBtn {
        width: 100%;
        text-align: center;
    }

    .select {
        color: var(--color-text);
        font-size: 16px !important;
        background-color: transparent;
    }
}
